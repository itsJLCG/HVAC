    "gulp-append-prepend": "1.0.9",
    "html5-qrcode": "^2.3.8",
    "hvac-inventory-borrowing-system": "file:..",
    "hvac-inventory-borrowing-system-backend": "file:../backend",
    "react": ">=16.8.0",
    "react-bootstrap": "2.4.0",
    "react-chartist": "0.14.4",
    "react-dom": ">=16.8.0",
    "react-notification-alert": "0.0.13",
